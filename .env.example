# ─── Supabase (required) ────────────────────────────────────────────────────────
# Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://pzrwtltcnjjjnhtpnztp.supabase.co
# Dashboard → Project Settings → API Keys → "Publishable key" (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Dashboard → Project Settings → API Keys → "Secret keys" → create/reveal (sb_secret_…). Server only — never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional: only for `npm run db:setup` against a fresh project.
# Dashboard → Connect → "Session pooler" connection string (replace [YOUR-PASSWORD]).
SUPABASE_DB_URL=

# ─── Demo mode ──────────────────────────────────────────────────────────────────
# Shows one-click persona sign-in on /login and the persona switcher in the sidebar.
DEMO_MODE=true
# Password given to the seeded demo personas (never sent to the browser).
DEMO_PASSWORD=mos-demo-2026!

# ─── Bifrost (optional; needs the Pixxel VPN) ───────────────────────────────────
BIFROST_ENABLED=false
BIFROST_BASE_URL=http://bifrost.pixxel.space
# Bifrost GUI → your workspace (shown in the URL / workspace switcher)
BIFROST_WORKSPACE=
# Bifrost GUI → Settings → API → workspace token (bfk_…)
BIFROST_API_TOKEN=
# Local checkout of mos-framework (copied, never modified, for the Python runner)
MOS_FRAMEWORK_PATH=/Users/hrijul.bhatnagar/Files/Code/mos-framework
